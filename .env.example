# Copy to .env and fill in. deploy.sh copies .env to the VM next to the compose
# file. Never commit .env.

GRAFANA_ADMIN_PASSWORD=

# Graylog: at least 16 characters, e.g. `openssl rand -hex 32`. Changing it later
# invalidates existing Graylog user passwords.
GRAYLOG_PASSWORD_SECRET=

# SHA-256 of the Graylog admin password:
#   echo -n 'yourpassword' | sha256sum | cut -d' ' -f1
GRAYLOG_ROOT_PASSWORD_SHA2=

# Must be a strong password (the image refuses weak ones).
OPENSEARCH_INITIAL_ADMIN_PASSWORD=

# bcrypt hash of the Filebrowser admin password (e.g. `filebrowser hash <password>`).
# Keep the single quotes: the value contains $ characters and .env is sourced by bash.
FILEBROWSER_ADMIN_PASSWORD_HASH=''

# ── GlitchTip (error tracking, shared by every project) ─────────────────────
# Postgres password. An existing data dir keeps the password it was created with,
# so when moving an existing GlitchTip DB this must stay as it was (glitchtip_secret).
GLITCHTIP_DB_PASSWORD=glitchtip_secret
# Django secret key, e.g. `openssl rand -hex 32`. Changing it signs everyone out.
GLITCHTIP_SECRET_KEY=
# The only account (open signup is disabled). deploy.sh creates it, and re-syncs the
# password on every deploy, so rotate it here and redeploy.
GLITCHTIP_ADMIN_EMAIL=admin@local.internal
GLITCHTIP_ADMIN_PASSWORD=
# Optional: the URL shown in DSNs and used in links (default http://192.168.100.10:10005).
# GLITCHTIP_DOMAIN=http://glitchtip.local.internal
